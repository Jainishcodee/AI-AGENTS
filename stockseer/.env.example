# Angel One SmartAPI -- optional. Without these, StockSeer runs on Yahoo data,
# which is ~15 minutes delayed on NSE (the dashboard says so on every screen).
#
# Create a MARKET FEED app at https://smartapi.angelone.in/ -- it has no order
# permissions, and this project never needs them.
#
# Copy this file to .env and fill it in. .env is gitignored; keep it that way.

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
# The base32 secret shown when you enable TOTP -- NOT the 6-digit code.
ANGEL_TOTP_SECRET=
