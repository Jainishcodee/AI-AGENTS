<question>
{{ context.question }}
</question>

DECISION CONTEXT
{% if context.normalised %}- the decision: {{ context.normalised }}{% endif %}
{% if context.domains %}- domains: {{ context.domains | join(', ') }}{% endif %}
{% if context.options %}- options on the table:
{% for o in context.options %}    · {{ o.id }} — {{ o.label }}{% if o.description %}: {{ o.description }}{% endif %}
{% endfor %}{% endif %}
{%- if context.actors %}- actors named by the user: {{ context.actors | join(', ') }}
{% endif %}
{%- if context.constraints %}- constraints: {{ context.constraints | join(' · ') }}
{% endif %}
{%- if context.current_state %}- current state: {{ context.current_state }}
