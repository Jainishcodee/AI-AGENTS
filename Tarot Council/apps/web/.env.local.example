# Copy to .env.local. Optional — the default is correct for local development.
#
# Where the Python reasoning core is listening. Read server-side only, by
# app/api/council/[...path]/route.ts. It is deliberately not NEXT_PUBLIC_: the
# browser never talks to the API directly, so this value never reaches a client
# bundle.
COUNCIL_API_URL=http://127.0.0.1:8787
