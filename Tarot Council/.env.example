# Copy to .env at the repo root. Nothing here is committed.
# The API loads this file at startup; the web app never sees any of it.

# ---------------------------------------------------------------- providers --
# Free tier, generous, no card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Gives access to free community models as a fallback when Gemini
# rate-limits mid-deliberation: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Only read if you route a role to them explicitly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional local fallback — costs nothing, needs `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434

# ------------------------------------------------------------------- routing --
# Model routing is by ROLE, not by name, so cost and quality are tuned in one
# place. Format: <provider>:<model>. Providers: gemini | openrouter | anthropic
# | openai | ollama | mock
#
# intake    - cheap, structural: classify the question           (1 call)
# reasoning - the six independent analyses, and their critiques   (6-18 calls)
# synthesis - reads everything and commits to a recommendation    (1 call)
#
# NOTE: gemini-2.5-pro is NOT on the Gemini free tier - it returns 429 with
# `limit: 0`. Flash is the strongest free synthesis model; point synthesis at pro
# only once you have a paid key.
COUNCIL_MODEL_INTAKE=gemini:gemini-2.5-flash-lite
COUNCIL_MODEL_REASONING=gemini:gemini-2.5-flash
COUNCIL_MODEL_SYNTHESIS=gemini:gemini-2.5-flash

# Used only when the primary provider for a role fails after its retries.
COUNCIL_MODEL_FALLBACK=

# ------------------------------------------------------------------ limits ---
# Two independent limits. Concurrency caps how many calls are in flight; MAX_RPM
# caps how many happen per minute, and the per-minute one is what free tiers
# actually meter. Observed Gemini free-tier limits (they change):
#   gemini-2.5-flash-lite  ~15 RPM
#   gemini-2.5-flash       ~10 RPM (observed as low as 5 on some projects)
#   gemini-2.5-pro           0 RPM  (not on the free tier at all)
# Set MAX_RPM to the lowest limit among the models you have routed. 0 disables
# pacing - do that only on a paid key.
COUNCIL_MAX_CONCURRENCY=3
COUNCIL_MAX_RPM=5
COUNCIL_REQUEST_TIMEOUT_S=120
COUNCIL_MAX_RETRIES=3

# quick    = intake -> reason -> synthesise                   (~8 calls)
# standard = quick + one critique round + confidence revision (~20 calls)
# deep     = standard, with two critique rounds               (~32 calls)
COUNCIL_DEFAULT_DEPTH=standard

# ----------------------------------------------------------------- server ----
COUNCIL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COUNCIL_LOG_LEVEL=INFO
# Persist deliberations as JSON under apps/api/var/deliberations/ so a restart
# does not lose history. Phase 2 replaces this with Postgres + pgvector.
COUNCIL_STORE=file
