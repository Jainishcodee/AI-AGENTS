# Copy this to .env and edit. Nothing here leaves your machine.

# --- identity ---
PET_NAME=Jarvis
PET_SCALE=1.0            # 0.7 = discreet, 1.4 = chunky

# --- voice ---
SPEAK=true               # offline Windows TTS
TTS_RATE=178

# --- where it lives ---
SCREEN_INDEX=0           # which monitor, 0 = primary
WALK_SPEED=70            # pixels/second
IDLE_WANDER_SEC=25       # how often it strolls somewhere new
SLEEP_AFTER_MIN=8        # naps if you leave it alone this long

# --- nudges ---
WATER_INTERVAL_MIN=45
QUOTE_INTERVAL_MIN=120
BATTERY_LOW_PCT=25       # nags you to plug in below this
BATTERY_FULL_PCT=85      # nags you to unplug above this
BATTERY_POLL_SEC=60

# Do-not-disturb window, 24h clock. Set both to the same number to disable.
# Low-battery warnings ignore this on purpose.
QUIET_START_HOUR=1
QUIET_END_HOUR=8

# --- ears (offline voice input) ---
VOICE_INPUT=true
WAKE_WORD=jarvis         # defaults to PET_NAME
# Leave unset and the pet picks the first input that isn't a virtual audio
# cable. Set it if it guesses wrong — tools/test_ears.py lists the options.
# MIC_INDEX=2
WHISPER_MODEL=base.en    # tiny.en is ~3x faster, noticeably less accurate
WHISPER_DEVICE=cpu       # the GPU's 4GB is busy holding phi4-mini
VAD_SENSITIVITY=2.6      # speech = this many times louder than the room
VAD_SILENCE_SEC=0.8      # silence that ends an utterance
FOLLOWUP_SEC=8           # after the wake word alone, how long to wait

# --- brain (local LLM, fallback only) ---
BRAIN_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_TIMEOUT=30
# Anything the MODEL interpreted needs a click first. It will invent a task
# from a sentence that wasn't a request. Plain commands skip this.
CONFIRM_MODEL_ACTIONS=true

# --- cold mail ---
# Gmail needs an APP PASSWORD, not your account password. Turn on 2FA, then
# myaccount.google.com/apppasswords. Leave blank and the pet drafts mail and
# shows it to you, but refuses to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_EMAIL=you@gmail.com
# SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM_NAME=Yash
MAIL_DAILY_LIMIT=20

# --- bubble timing ---
BUBBLE_SEC_PER_10_CHARS=0.55
BUBBLE_MIN_SEC=3.5
