{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noircity",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",

  // `nodejs_compat` is required by the OpenNext adapter, which shims the Node
  // built-ins Next.js reaches for. Nothing in this app calls `fs` at runtime -
  // case files and the navigation city are bundled as static imports, because a
  // Worker has no filesystem to read from.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Marks the written half of an accusation. A binding rather than an API call:
  // no key to hold, no outbound request, and it runs in this worker.
  //
  // Optional by design. Locally and in the test suite there is no binding, and
  // `lib/server/aiGrade.ts` falls back to keyword coverage and tells the player
  // so in the verdict. The game is never unplayable because a model is not
  // there - it is marked more bluntly, which is a different thing.
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  }
}
