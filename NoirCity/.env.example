# Multiplayer is optional. Leave these unset and the game runs solo against an
# in-memory store — every case is fully playable, just not shareable.
#
# To enable rooms, create a free project at https://supabase.com and copy the
# values from Project Settings → API.

# Project URL and the public anon key. Safe to expose to the browser: they are
# useless without a session, and RLS decides what a session can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key BYPASSES row level security. It is what lets the server
# write game state that no player is allowed to write themselves.
#
# Never prefix this with NEXT_PUBLIC_, never commit it, and never import it from
# a client component — `lib/supabase/server.ts` is marked `server-only` so that
# last one is a build error rather than a bad afternoon.
SUPABASE_SERVICE_ROLE_KEY=
