# ---- Build output -------------------------------------------------------
# Regenerated by every `flutter build`. These were tracked once, which is why
# a single rebuild used to show up as ~7,600 changed files.
Jarvis/build/
Jarvis/.dart_tool/
Jarvis/android/.gradle/
Jarvis/android/.kotlin/
Jarvis/.idea/
*.iml

# ---- Python -------------------------------------------------------------
__pycache__/
*.pyc

# ---- Secrets ------------------------------------------------------------
.env
reelflow/cookies.txt
cookies.txt

# ---- Personal data ------------------------------------------------------
# The raw Instagram export and everything derived from it: saved captions,
# creator handles, downloaded audio. Re-requestable from Instagram, and not
# something to push to a remote. The finished deck the app ships
# (Jarvis/assets/deck.json) IS tracked -- that's the product.
your_instagram_activity/
instagram-*/
reelflow/data/
pilot/audio/
pilot/transcripts/

# ---- Health data — NEVER COMMIT -----------------------------------------
# Body photos, measurements, lab values, and anything derived from them.
# Unlike the reel deck, there is no version of this that ships. If a Jarvis
# health module is built, its output belongs here too, not in Jarvis/assets/.
# Do not narrow this rule to specific files -- the whole tree stays out.
health/
**/health_private/
*.health.json
*.health.md
