# --- Voice ---
WAKE_WORD=jarvis         # what you say to summon Jarvis
SPEAK=true               # false = print only, no text-to-speech
MIC_INDEX=2              # mic device index (see ../Mingo/mic_test.py for the list)
ENERGY_THRESHOLD=        # set a number (e.g. 300) only if calibration picks a bad value

# --- Weather agent (OpenWeatherMap) ---
OPENWEATHER_API_KEY=     # get one free at https://openweathermap.org/api
WEATHER_LOCATION=Mumbai  # default city if no location is spoken

# --- Mingo integration ---
# Path to the Mingo folder. Default is `..\Mingo` next to Jarvis.
MINGO_DIR=

