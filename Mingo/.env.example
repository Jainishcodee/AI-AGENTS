# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in what you need. Anything left blank uses
# the default shown in parentheses.
# ---------------------------------------------------------------------------

# --- SPARE Microsoft account (the one Mingo automates) ---
# Optional. Leave BOTH blank to just sign in manually in the browser window the
# first time Mingo runs (recommended — nothing is stored).
MS_EMAIL=
MS_PASSWORD=

# --- Bing search volume ---
DESKTOP_SEARCHES=32      # ~3 points per search, capped around 90-150 pts/day
MOBILE_SEARCHES=22       # mobile cap is lower

# --- Voice ---
WAKE_WORD=mingo          # what you say to start it
SPEAK=true               # false = print only, no text-to-speech
MIC_INDEX=               # mic device index; run `python mic_test.py` to find it. blank = system default
ENERGY_THRESHOLD=        # set a number (e.g. 300) only if it never hears you / triggers on noise

# --- Browser ---
HEADLESS=false           # keep false so you can see/intervene; true hides it

# --- Email reminder for your MAIN account ---
# Gmail that SENDS the reminder. Create an App Password (NOT your real password):
#   https://myaccount.google.com/apppasswords
SMTP_EMAIL=jainishshah356@gmail.com
SMTP_APP_PASSWORD=ipfbuzaletvphyui
REMINDER_TO=jainishshah796@gmail.com
REMINDER_INTERVAL_HOURS=5
SEND_REMINDER_ON_START=false
